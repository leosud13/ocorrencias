generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  OCCURRENCE_ACTION_TAKEN
}

enum UserRole {
  PROFESSOR
  GESTAO
  AGENTE_ESCOLAR
}

enum OccurrenceReason {
  INDISCIPLINA
  USO_CELULAR
  SAIU_SEM_AUTORIZACAO
  NAO_FEZ_ATIVIDADE
  LINGUAGEM_IMPROPRIA
  BULLYING
  AGRESSAO
  SUBSTANCIAS_ILICITAS
  DESACATO_FUNCIONARIO
  CONVERSAS_PARALELAS
  BUSCA_ATIVA
  OUTROS
}

enum OccurrenceLocation {
  SALA_DE_AULA
  PATIO
  QUADRA
  BANHEIRO
  CORREDORES
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         UserRole
  imageUrl     String?
  isBlocked    Boolean       @default(false)
  blockedAt    DateTime?
  occurrences  Occurrence[]  @relation("AuthorOccurrences")
  comments     OccurrenceComment[] @relation("OccurrenceCommentAuthor")
  notifications Notification[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SchoolClass {
  id           String        @id @default(cuid())
  name         String
  students     Student[]
  occurrences  Occurrence[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Student {
  id           String        @id @default(cuid())
  name         String
  ra           String        @unique
  classId      String
  class        SchoolClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  occurrences  Occurrence[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([classId])
}

model Occurrence {
  id              String             @id @default(cuid())
  controlNumber   String             @unique
  authorId        String
  author          User               @relation("AuthorOccurrences", fields: [authorId], references: [id])
  classId         String
  schoolClass     SchoolClass        @relation(fields: [classId], references: [id])
  studentId       String
  student         Student            @relation(fields: [studentId], references: [id])
  registeredAt    DateTime           @default(now())
  occurredAt      DateTime
  location        OccurrenceLocation
  reason          OccurrenceReason
  details         String?
  parentName      String?
  parentPhone     String?
  parentEmail     String?
  actionTaken     String?
  attachments     OccurrenceAttachment[]
  comments        OccurrenceComment[]
  notifications   Notification[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([authorId])
  @@index([classId])
  @@index([registeredAt])
}

model OccurrenceComment {
  id            String      @id @default(cuid())
  occurrenceId  String
  occurrence    Occurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation("OccurrenceCommentAuthor", fields: [authorId], references: [id])
  content       String
  createdAt     DateTime    @default(now())

  @@index([occurrenceId])
  @@index([authorId])
}

model OccurrenceAttachment {
  id            String      @id @default(cuid())
  occurrenceId  String
  occurrence    Occurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  fileName      String
  storedPath    String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime    @default(now())

  @@index([occurrenceId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrenceId  String
  occurrence    Occurrence       @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, readAt])
  @@index([occurrenceId])
}
