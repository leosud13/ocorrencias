# PostgreSQL (Neon, Supabase, Render, etc.) — obrigatório na Vercel
# Exemplo Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# URL pública do site (produção: https://wanda-ocorrencias.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Gere um segredo forte: openssl rand -base64 32
NEXTAUTH_SECRET="troque-este-segredo-em-producao-use-openssl-rand-base64-32"
